# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for Dig Driving School.
# Local dev: copy this file to .env and fill in values.
# Production (IONOS/Plesk): set these in Plesk → Node.js → Custom environment
# variables. NEVER commit real values — only this template is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (SQLite file on the server) ──
# The file lives on the server and is gitignored so deploys never overwrite it.
DATABASE_URL="file:./prisma/dev.db"

# ── Admin auth ──
# Secret used to sign the admin login JWT.
# Generate a strong value with:  openssl rand -base64 32
JWT_SECRET="change-me"

# ── Email (Resend) — enquiry auto-reply, notifications & admin replies ──
# API key from https://resend.com (Account → API Keys). Leave blank to disable
# email entirely (enquiries still save to the database as normal).
RESEND_API_KEY=""
# Sender address. MUST be on a domain you've verified in Resend
# (Resend → Domains → add your domain and its DNS records).
EMAIL_FROM="Dig Driving School <hello@digdrivingschool.co.uk>"
# The owner's inbox. Gets enquiry notifications, and is the reply-to on
# customer emails so their replies land in that inbox.
OWNER_EMAIL=""
